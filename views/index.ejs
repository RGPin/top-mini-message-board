<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="index.css" />
  </head>
  <body>
    <h1><%= title%></h1>
    <% messages.forEach((message) => { %>
      <div>
        <p><%= message.text %></p>
        <p><%= message.username %></p>
        <p><%= message.added %></p>
        <a href="/details/<%= message.id %>">View details</a>
      </div>
    <% }) %>
    <a href="/new">Enter new message</a>
  </body>
</html>
